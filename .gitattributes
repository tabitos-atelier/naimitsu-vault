# Auto detect text files and normalize line endings
* text=auto

# Binary files
*.jpg    binary
*.jpeg   binary
*.png    binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.db     binary
*.sqlite binary

# .NET / C# source files
*.cs      diff=csharp text eol=crlf
*.xaml    text eol=crlf
*.xaml.cs text eol=crlf
*.sln     text eol=crlf
*.csproj  text eol=crlf

# Cross-platform text files
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
LICENSE  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Setup scripts
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf