<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NaimitsuVault.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24">
        <StackPanel
            MaxWidth="600"
            Margin="24"
            HorizontalAlignment="Center"
            Spacing="24">

            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Image
                    Width="192"
                    Height="192"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///Assets/NaimitsuVault.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource NvTitleFontSize}"
                    FontWeight="SemiBold"
                    Text="{loc:Msg Key=System.Product.Name}" />
                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Version}" />
            </StackPanel>

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Msg Key=System.Product.Description}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel HorizontalAlignment="Center" Spacing="8">

                <HyperlinkButton
                    Padding="16,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OpenLink"
                    Tag="https://github.com/tabitos-atelier">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Data="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                        <TextBlock VerticalAlignment="Center" Text="@tabitos-atelier  (En/Ja)" />
                    </StackPanel>
                </HyperlinkButton>

                <HyperlinkButton
                    Padding="16,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OpenLink"
                    Tag="https://tabitos-voyage.com/about">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvIconSizeLarge}"
                            Glyph="&#xE774;" />
                        <TextBlock VerticalAlignment="Center" Text="Tabito's Voyage - Profile  (Ja)" />
                    </StackPanel>
                </HyperlinkButton>

                <HyperlinkButton
                    Padding="16,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OpenLink"
                    Tag="https://x.com/TabitosPharos">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.261 5.635zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        <TextBlock VerticalAlignment="Center" Text="@TabitosPharos  (Ja)" />
                    </StackPanel>
                </HyperlinkButton>

            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=System.Product.Copyright}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=System.Product.License}" />
                <TextBlock
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{loc:Msg Key=System.Product.Disclaimer}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
