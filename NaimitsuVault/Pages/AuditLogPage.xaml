<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NaimitsuVault.Pages.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization"
    xmlns:vm="using:NaimitsuVault.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,8,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                Margin="0,0,8,0"
                PlaceholderText="{loc:Msg Key=AuditLog.SearchPlaceholder}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Column="1"
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvBodyFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=AuditLog.Severity}" />
                <ComboBox
                    MinWidth="90"
                    SelectedIndex="{x:Bind ViewModel.SelectedLevelIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Msg Key=Common.All}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.SeverityNormal}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.SeverityNotice}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.SeverityImportant}" />
                </ComboBox>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvBodyFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=AuditLog.Code}" />
                <ComboBox
                    MinWidth="110"
                    SelectedIndex="{x:Bind ViewModel.SelectedCodeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Msg Key=Common.All}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryRead}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryConfig}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryAuth}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryWrite}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryPurge}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategoryPrivilege}" />
                    <ComboBoxItem Content="{loc:Msg Key=AuditLog.FilterCategorySystem}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <!--  Two placeholders: no audit log at all vs. filters that hid every existing row  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Msg Key=AuditLog.NoActivityPlaceholder}"
                Visibility="{x:Bind ViewModel.ShowNoActivityPlaceholder, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Msg Key=AuditLog.NoMatchingActivityPlaceholder}"
                Visibility="{x:Bind ViewModel.ShowNoMatchPlaceholder, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <ListView
                x:Name="AuditLogListView"
                Padding="24,0,24,16"
                ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}"
                KeyDown="AuditLogListView_KeyDown"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.HasLogs, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,4,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditLogDisplayItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  Log ID  -->
                            <TextBlock
                                Grid.Column="0"
                                FontSize="{StaticResource NvBodyFontSize}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Id}"
                                TextAlignment="Right" />
                            <!--  EventLevel icon  -->
                            <FontIcon
                                Grid.Column="1"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Foreground="{x:Bind EventLevel, Converter={StaticResource AuditLevelToBrushConverter}}"
                                Glyph="{x:Bind EventLevel, Converter={StaticResource AuditSeverityBulletConverter}}" />
                            <!--  Date/time (local time, OS-culture "g" format)  -->
                            <TextBlock
                                Grid.Column="2"
                                FontSize="{StaticResource NvBodyFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind CreatedAtDisplay}" />
                            <!--  Event code  -->
                            <TextBlock
                                Grid.Column="3"
                                FontSize="{StaticResource NvBodyFontSize}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind EventCodeDisplay}"
                                TextAlignment="Right" />
                            <!--  Log content  -->
                            <TextBlock
                                Grid.Column="4"
                                FontSize="{StaticResource NvBodyFontSize}"
                                Text="{x:Bind Summary}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
