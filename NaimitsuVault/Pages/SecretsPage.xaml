<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NaimitsuVault.Pages.SecretsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NaimitsuVault.Views.Controls"
    xmlns:loc="using:NaimitsuVault.Localization"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnDef" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPane" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    IsEnabled="{x:Bind ViewModel.HasAnySecrets, Mode=OneWay}"
                    PlaceholderText="{loc:Msg Key=Secrets.SearchPlaceholder}"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Padding="8,0"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    Content="✕"
                    Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <ComboBox
                x:Name="CategoryFilter"
                Grid.Row="1"
                Margin="8,4,8,0"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Name"
                IsEnabled="{x:Bind ViewModel.HasAnySecrets, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilterComboItems, Mode=OneWay}"
                SelectedValue="{x:Bind ViewModel.FilterCategoryCode, Mode=TwoWay}"
                SelectedValuePath="Code" />

            <!--  Favorites / Draft / Expiration filters (toggle buttons, horizontal row)  -->
            <StackPanel
                Grid.Row="2"
                Margin="8"
                Orientation="Horizontal"
                Spacing="8">
                <!--  Favorites  -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        Padding="6,4"
                        Foreground="#FFD700"
                        IsChecked="{x:Bind ViewModel.FilterFavoritesOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasFilteredFavorites, Mode=OneWay}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE735;" />
                    </ToggleButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FilteredFavoritesCount, Mode=OneWay}" />
                </StackPanel>
                <!--  Draft (disabled when count is zero)  -->
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        Padding="6,4"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        IsChecked="{x:Bind ViewModel.FilterDraftOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasFilteredDraft, Mode=OneWay}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE70F;" />
                    </ToggleButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FilteredDraftCount, Mode=OneWay}" />
                </StackPanel>
                <!--  Expiration alert (soon-to-expire + expired total, disabled when count is zero)  -->
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        Padding="6,4"
                        Foreground="{x:Bind GetExpiryAlertForeground(ViewModel.HasFilteredExpired, ViewModel.HasFilteredExpiredPastDue), Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.FilterExpiredOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasFilteredExpired, Mode=OneWay}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xEC92;" />
                    </ToggleButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FilteredExpiredCount, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="SecretListView"
                Grid.Row="3"
                ItemsSource="{x:Bind ViewModel.FilteredSecrets, Mode=OneWay}"
                KeyDown="SecretListView_KeyDown"
                SelectionChanged="SecretList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  Star button (leftmost)  -->
                            <Button
                                Grid.Column="0"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="StarButton_Click">
                                <Grid>
                                    <FontIcon
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Foreground="#FFD700"
                                        Glyph="&#xE735;"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE734;"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <!--  Favicon (protected-document icon shown until fetched)  -->
                            <Grid
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="{StaticResource NvIconSizeSmall}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A6;" />
                                <Image Source="{Binding FaviconSource}" Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  Draft indicator (pencil icon)  -->
                            <FontIcon
                                Grid.Column="3"
                                FontSize="{StaticResource NvIconSizeSmall}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE70F;"
                                ToolTipService.ToolTip="{loc:Msg Key=Secrets.HasDraftBadgeTooltip}"
                                Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!--  Expiration warning (same icon: yellow = expiring soon, red = expired)  -->
                            <FontIcon
                                Grid.Column="4"
                                FontSize="{StaticResource NvIconSizeSmall}"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xEC92;"
                                ToolTipService.ToolTip="{Binding ExpiresAt}"
                                Visibility="{Binding IsExpiringSoon, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <FontIcon
                                Grid.Column="4"
                                FontSize="{StaticResource NvIconSizeSmall}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xEC92;"
                                ToolTipService.ToolTip="{Binding ExpiresAt}"
                                Visibility="{Binding IsExpired, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Add button + item count  -->
            <Grid Grid.Row="4" Margin="8,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="AddSecretButton"
                    Grid.Column="0"
                    AutomationProperties.Name="{loc:Msg Key=Secrets.Add}"
                    Command="{x:Bind ViewModel.AddSecretCommand}"
                    ToolTipService.ToolTip="{loc:Msg Key=Secrets.Add}">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE710;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SecretCountLabel, Mode=OneWay}" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Padding="24,16,24,16">
            <!--  Shown when nothing is selected  -->
            <Grid Visibility="{x:Bind ViewModel.HasEditingSecret, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Image
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.2"
                    Source="ms-appx:///Assets/NaimitsuVault.png"
                    Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=Secrets.SelectOrCreatePrompt}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Edit form  -->
            <Grid Visibility="{x:Bind ViewModel.HasEditingSecret, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="DetailScrollViewer" Grid.Row="0">
                    <StackPanel
                        x:Name="DetailFormPanel"
                        Margin="0,0,0,16"
                        Spacing="16">

                        <!--
                            =====================================================================
                            Basic info group (Title through ExpiresAt)
                            Unified column layout (matches custom fields' Col.1-4):
                            Col.0: Width="140"  Label
                            Col.1: Width="*"    Input field (right edge aligned across all rows)
                            Col.2: Width="32"   Button slot 1
                            Col.3: Width="32"   Button slot 2

                            Col.1 also hosts an overlaid copy button (right-aligned inside the
                            TextBox, right Padding reserved to make room for it). It is hidden on
                            focus via CopyOverlayTextBox_GotFocus/LostFocus so it never overlaps
                            WinUI 3's built-in TextBox delete ("x") button, which only appears
                            while focused with non-empty text.
                            =====================================================================
                        -->

                        <!--  Title / Category  -->
                        <StackPanel Spacing="8">

                            <!--  Title  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Msg Key=Common.Title}" />
                                <TextBox
                                    x:Name="TitleField"
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    GotFocus="CopyOverlayTextBox_GotFocus"
                                    LostFocus="CopyOverlayTextBox_LostFocus"
                                    PlaceholderText="{loc:Msg Key=Secrets.ExampleTitle}"
                                    Text="{x:Bind ViewModel.EditingSecret.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  Copy button (overlaid inside the text box, right edge; hidden on focus to avoid overlapping the built-in delete button)  -->
                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.CopyFieldCommand}"
                                    CommandParameter="Title"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.Title, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Tag="CopyOverlay"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                </Button>
                                <!--  Col.3: empty (width reservation only)  -->
                            </Grid>

                            <!--  Category  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Msg Key=Secrets.CategorySelection}" />
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.CategoryComboItems, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.EditingSecret.CategoryComboSelection, Mode=TwoWay}"
                                    SelectedValuePath="Code" />
                                <!--  Col.2-3: empty (width reservation only)  -->
                            </Grid>

                            <!--  Credentials group (username / password / 2FA)  -->
                            <!--
                                Username
                                Copy button is overlaid inside Col.1 (same cell as the TextBox, right edge).
                                Col.2 hosts the enlarge-preview toggle; Col.3 hosts the Direct Injection trigger button.

                                ⛔ Do not restyle the label column (Col.0)
                                NG #1: Cannot override TextBox's ControlTemplate.
                                WinUI 3's native behavior forces ContentElement.VerticalAlignment
                                back to Top on every Focus event. Cannot be fixed from XAML.
                                NG #2: The same constraint applies if TextBox is reverted to EditableLabelStyle.
                                Correct approach: the "Border + TextBlock (display) + TextBox (edit, Collapsed)"
                                three-layer structure + LabelGrid_PointerEntered/Exited is this page's confirmed solution.
                            -->
                            <Grid ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsHitTestVisible="{x:Bind ViewModel.EditingSecret.UserId, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Opacity="{x:Bind ViewModel.EditingSecret.UserId, Mode=OneWay, Converter={StaticResource EmptyToDisabledOpacityConverter}}"
                                    PointerEntered="LabelGrid_PointerEntered"
                                    PointerExited="LabelGrid_PointerExited">
                                    <Border
                                        Background="Transparent"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                    <TextBlock
                                        Padding="4,4,4,4"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="1"
                                        Tapped="LabelDisplay_Tapped"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelUserId, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.EditingSecret.LabelUserId, Mode=OneWay}" />
                                    <TextBox
                                        MinHeight="0"
                                        Padding="4,8,4,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        LostFocus="LabelEditor_LostFocus"
                                        Tag="{loc:Msg Key=Common.Username}"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelUserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    GotFocus="CopyOverlayTextBox_GotFocus"
                                    LostFocus="CopyOverlayTextBox_LostFocus"
                                    PlaceholderText="{loc:Msg Key=Secrets.ExampleUsername}"
                                    Text="{x:Bind ViewModel.EditingSecret.UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  Copy button (overlaid inside the text box, right edge; hidden on focus to avoid overlapping the built-in delete button)  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.CopyFieldCommand}"
                                    CommandParameter="UserId"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.UserId, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Tag="CopyOverlay"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                </Button>
                                <!--  Enlarge-preview toggle (same position/size as the password field's reveal toggle)  -->
                                <ToggleButton
                                    x:Name="UserIdEnlargeToggle"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="UserIdEnlargeToggle_Click"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.EnlargeDisplay}">
                                    <FontIcon
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Glyph="{x:Bind UserIdEnlargeToggle.IsChecked, Mode=OneWay, Converter={StaticResource BoolToZoomGlyphConverter}}" />
                                </ToggleButton>
                                <!--  Direct Injection trigger button  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    Click="InjectButton_Click"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsEnabled="{x:Bind ViewModel.HasEditingSecret, Mode=OneWay}"
                                    ToolTipService.ToolTip="{loc:Msg Key=DirectInjection.Title}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8F0;" />
                                </Button>
                                <!--  Row=1: Large preview (spans all columns, including the label column, to match RecordExtrasControl's width)  -->
                                <controls:UserIdLargePreviewControl
                                    x:Name="UserIdLargePreview"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4" />
                            </Grid>

                            <!--  Password (rows expanded to hold sub-elements)  -->
                            <Grid ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <!--  Row=0: Label  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsHitTestVisible="{x:Bind ViewModel.EditingSecret.Password, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Opacity="{x:Bind ViewModel.EditingSecret.Password, Mode=OneWay, Converter={StaticResource EmptyToDisabledOpacityConverter}}"
                                    PointerEntered="LabelGrid_PointerEntered"
                                    PointerExited="LabelGrid_PointerExited">
                                    <Border
                                        Background="Transparent"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                    <TextBlock
                                        Padding="4,4,4,4"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="1"
                                        Tapped="LabelDisplay_Tapped"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelPassword, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.EditingSecret.LabelPassword, Mode=OneWay}" />
                                    <TextBox
                                        MinHeight="0"
                                        Padding="4,8,4,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        LostFocus="LabelEditor_LostFocus"
                                        Tag="{loc:Msg Key=Common.Password}"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <!--  Row=0: Masked input  -->
                                <PasswordBox
                                    x:Name="PasswordField"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    PasswordChanged="PasswordField_Changed"
                                    PasswordRevealMode="Hidden"
                                    PlaceholderText="{loc:Msg Key=Common.Password}" />
                                <!--  Row=0: Plain-text input (shown when reveal toggle is ON)  -->
                                <TextBox
                                    x:Name="PasswordFieldRevealed"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    GotFocus="CopyOverlayTextBox_GotFocus"
                                    LostFocus="CopyOverlayTextBox_LostFocus"
                                    PlaceholderText="{loc:Msg Key=Common.Password}"
                                    TextChanged="PasswordFieldRevealed_Changed"
                                    Visibility="Collapsed" />
                                <!--  Row=0: Copy button (overlaid inside the password box, right edge; hidden on focus only for the plain-text box, since PasswordBox has no built-in delete button)  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.CopyFieldCommand}"
                                    CommandParameter="Password"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.Password, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Tag="CopyOverlay"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                </Button>
                                <!--  Row=0: Reveal toggle  -->
                                <ToggleButton
                                    x:Name="PasswordRevealToggle"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="PasswordRevealToggle_Click"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.ToggleVisibility}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE7B3;" />
                                </ToggleButton>
                                <!--  Row=0: Generator toggle  -->
                                <ToggleButton
                                    x:Name="PasswordGeneratorToggle"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ShowPasswordGenerator"
                                    ToolTipService.ToolTip="{loc:Msg Key=Secrets.GeneratePassword}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE713;" />
                                </ToggleButton>
                                <!--  Row=1: Strength indicator (spans Col.1-3)  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.EditingSecret.HasPasswordStrength, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind ViewModel.EditingSecret.PasswordStrengthLevel, Mode=OneWay, Converter={StaticResource StrengthLevelToBrushConverter}}"
                                        Maximum="4"
                                        Value="{x:Bind ViewModel.EditingSecret.PasswordStrengthLevel, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvCaptionFontSize}"
                                        Foreground="{x:Bind ViewModel.EditingSecret.PasswordStrengthLevel, Mode=OneWay, Converter={StaticResource StrengthLevelToBrushConverter}}"
                                        Text="{x:Bind ViewModel.EditingSecret.PasswordStrengthText, Mode=OneWay}" />
                                </StackPanel>
                                <!--  Row=2: Large preview (spans all columns, including the label column, to match RecordExtrasControl's width)  -->
                                <controls:PasswordLargePreviewControl
                                    x:Name="PasswordLargePreview"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4" />
                                <!--  Row=3: Generator panel (spans all columns, including the label column, for more room)  -->
                                <Border
                                    x:Name="PasswordGeneratorPanel"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Margin="0,8,0,0"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="8">
                                        <!--  Character-type checkbox row (4-column Grid: CheckBox+TextBox nested in Col3)  -->
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Grid.Column="0"
                                                Content="A-Z"
                                                IsChecked="{x:Bind ViewModel.PwdUseUpper, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="a-z"
                                                IsChecked="{x:Bind ViewModel.PwdUseLower, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Content="0-9"
                                                IsChecked="{x:Bind ViewModel.PwdUseDigits, Mode=TwoWay}" />
                                            <!--  Col3: symbol CheckBox (Auto) + GenSymbols TextBox (*) share a nested Grid  -->
                                            <Grid Grid.Column="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Margin="8,0,0,0"
                                                    IsChecked="{x:Bind ViewModel.PwdUseSymbols, Mode=TwoWay}" />
                                                <Grid
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    PointerEntered="LabelGrid_PointerEntered"
                                                    PointerExited="LabelGrid_PointerExited">
                                                    <Border
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        IsHitTestVisible="False" />
                                                    <TextBox
                                                        Width="110"
                                                        MinHeight="0"
                                                        Padding="4,8,0,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontSize="{StaticResource NvCaptionFontSize}"
                                                        Text="{x:Bind ViewModel.EditingSecret.GenSymbols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <!--  Length slider + symbol set editor  -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Slider
                                                x:Name="PwdLengthSlider"
                                                Width="480"
                                                Maximum="64"
                                                Minimum="8"
                                                StepFrequency="1"
                                                ValueChanged="PwdLengthSlider_ValueChanged"
                                                Value="{x:Bind ViewModel.PwdLength, Mode=TwoWay}" />
                                            <TextBlock
                                                MinWidth="20"
                                                Margin="0,0,24,0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind ViewModel.PwdLength, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="GeneratePassword_Click"
                                            IsEnabled="{x:Bind ViewModel.CanGeneratePassword, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8D7;" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:Msg Key=Secrets.GeneratePassword}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Two-factor authentication (directly below password)  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Msg Key=Common.TotpSecret}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <ToggleSwitch
                                        x:Name="TotpToggle"
                                        IsEnabled="{x:Bind ViewModel.EditingSecret.CanTotpToggle, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.HasTotp, Mode=OneWay}"
                                        OffContent="{loc:Msg Key=Common.Off}"
                                        OnContent="{loc:Msg Key=Common.On}"
                                        Toggled="TotpToggle_Toggled"
                                        ToolTipService.ToolTip="{loc:Msg Key=Secrets.ToggleTotpTooltip}">
                                        <!--  WinUI 3's DefaultToggleSwitchStyle bakes a 10px top+bottom margin into the
                                             control template (ToggleSwitchPreContentMargin/PostContentMargin), on top of
                                             whatever external spacing is applied - this is what made the gap above/below
                                             this row look wider than the other fields even after the StackPanel merge.
                                             Overriding the keys here (element-scoped) zeroes it out for this control only. -->
                                        <ToggleSwitch.Resources>
                                            <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
                                            <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                    <!--  TOTP code display (shown only when HasTotp)  -->
                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasTotp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="{StaticResource NvTitleFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind ViewModel.TotpCodeDisplay, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.TotpCodeIsExpiring, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="{StaticResource NvTitleFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Text="{x:Bind ViewModel.TotpCodeDisplay, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.TotpCodeIsExpiring, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock
                                                    VerticalAlignment="Bottom"
                                                    FontSize="{StaticResource NvCaptionFontSize}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.TotpSecondsLabel, Mode=OneWay}" />
                                            </StackPanel>
                                            <!--  Copy button (overlaid at the right edge, matching the other fields' copy button position)  -->
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind ViewModel.CopyTotpCommand}"
                                                IsEnabled="{x:Bind ViewModel.TotpCode, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                                ToolTipService.ToolTip="{loc:Msg Key=Secrets.CopyTotpCodeTooltip}">
                                                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                            </Button>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <ProgressBar
                                                    Maximum="30"
                                                    Minimum="0"
                                                    Value="{x:Bind ViewModel.TotpSecondsRemaining, Mode=OneWay}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="{StaticResource NvBodyFontSize}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind ViewModel.TotpAdjacentLabel, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{loc:Msg Key=Totp.TimeSyncNotice}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!--  Contact info group (website / email / expiry)  -->
                            <!--  Website  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    IsHitTestVisible="{x:Bind ViewModel.EditingSecret.Website, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Opacity="{x:Bind ViewModel.EditingSecret.Website, Mode=OneWay, Converter={StaticResource EmptyToDisabledOpacityConverter}}"
                                    PointerEntered="LabelGrid_PointerEntered"
                                    PointerExited="LabelGrid_PointerExited">
                                    <Border
                                        Background="Transparent"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                    <TextBlock
                                        Padding="4,4,4,4"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="1"
                                        Tapped="LabelDisplay_Tapped"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelUrl, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.EditingSecret.LabelUrl, Mode=OneWay}" />
                                    <TextBox
                                        MinHeight="0"
                                        Padding="4,8,4,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        LostFocus="LabelEditor_LostFocus"
                                        Tag="{loc:Msg Key=Common.Website}"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBox
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    GotFocus="CopyOverlayTextBox_GotFocus"
                                    LostFocus="CopyOverlayTextBox_LostFocus"
                                    PlaceholderText="{loc:Msg Key=Secrets.ExampleUrl}"
                                    Text="{x:Bind ViewModel.EditingSecret.Website, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  Copy button (overlaid inside the text box, right edge; hidden on focus to avoid overlapping the built-in delete button)  -->
                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.CopyFieldCommand}"
                                    CommandParameter="Website"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.Website, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Tag="CopyOverlay"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                </Button>
                                <!--  Open-in-browser button (external action = Accent color)  -->
                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.OpenWebsiteCommand}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.Website, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.OpenInBrowser}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE774;" />
                                </Button>
                                <!--  Col.3: empty (width reservation only, matches Password row's trailing columns)  -->
                            </Grid>

                            <!--  Email  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    IsHitTestVisible="{x:Bind ViewModel.EditingSecret.Email, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Opacity="{x:Bind ViewModel.EditingSecret.Email, Mode=OneWay, Converter={StaticResource EmptyToDisabledOpacityConverter}}"
                                    PointerEntered="LabelGrid_PointerEntered"
                                    PointerExited="LabelGrid_PointerExited">
                                    <Border
                                        Background="Transparent"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                    <TextBlock
                                        Padding="4,4,4,4"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="1"
                                        Tapped="LabelDisplay_Tapped"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelEmail, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.EditingSecret.LabelEmail, Mode=OneWay}" />
                                    <TextBox
                                        MinHeight="0"
                                        Padding="4,8,4,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{StaticResource NvBodyFontSize}"
                                        LostFocus="LabelEditor_LostFocus"
                                        Tag="{loc:Msg Key=Common.Email}"
                                        Text="{x:Bind ViewModel.EditingSecret.LabelEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBox
                                    Grid.Column="1"
                                    Padding="10,5,40,7"
                                    GotFocus="CopyOverlayTextBox_GotFocus"
                                    LostFocus="CopyOverlayTextBox_LostFocus"
                                    PlaceholderText="{loc:Msg Key=Secrets.ExampleEmail}"
                                    Text="{x:Bind ViewModel.EditingSecret.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  Copy button (overlaid inside the text box, right edge; hidden on focus to avoid overlapping the built-in delete button)  -->
                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.CopyFieldCommand}"
                                    CommandParameter="Email"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.Email, Mode=OneWay, Converter={StaticResource NotNullOrEmptyToBoolConverter}}"
                                    Tag="CopyOverlay"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                                </Button>
                                <!--  Col.2-3: empty (width reservation only, matches Password row's trailing columns)  -->
                            </Grid>

                            <!--  ExpiresAt (label gets an alert glyph + coloring when nearing/past expiry, matching ProfilePage's identity item expiry labels)  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Margin (not Grid.ColumnSpacing) provides the icon-to-label gap, since ColumnSpacing
                                          would reserve it unconditionally even while the icon is Collapsed (no active alert),
                                          pushing the label out of alignment with the plain fields above it.  -->
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Foreground="{x:Bind GetExpiryAlertForeground(ViewModel.EditingSecret.HasExpiryAlert, ViewModel.EditingSecret.IsExpired), Mode=OneWay}"
                                        Glyph="&#xEC92;"
                                        Visibility="{x:Bind ExpiryAlertVisibility(ViewModel.EditingSecret.HasExpiryAlert), Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind GetExpiryAlertForeground(ViewModel.EditingSecret.HasExpiryAlert, ViewModel.EditingSecret.IsExpired), Mode=OneWay}"
                                        Text="{loc:Msg Key=Common.ExpiresAt}" />
                                </Grid>
                                <CalendarDatePicker
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Date="{x:Bind ViewModel.EditingSecret.ExpiresAt, Mode=TwoWay}"
                                    DateChanged="ExpiresAtPicker_DateChanged"
                                    PlaceholderText="{loc:Msg Key=Secrets.NoExpiry}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ExpiryDateTooltip}" />
                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.ClearExpiryCommand}"
                                    IsEnabled="{x:Bind ViewModel.EditingSecret.HasExpiry, Mode=OneWay}"
                                    ToolTipService.ToolTip="{loc:Msg Key=Common.ClearExpiry}">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE75C;" />
                                </Button>
                                <!--  Col.3: empty (width reservation only, matches Password row's trailing columns)  -->
                            </Grid>
                        </StackPanel>

                        <controls:RecordExtrasControl
                            x:Name="RecordExtras"
                            AddCustomFieldCommand="{x:Bind ViewModel.AddCustomFieldCommand}"
                            AttachedFiles="{x:Bind ViewModel.EditingSecret.AttachedFiles, Mode=OneWay}"
                            CopyCustomFieldCommand="{x:Bind ViewModel.CopyCustomFieldCommand}"
                            CreatedAtText="{x:Bind ViewModel.EditingSecret.CreatedAtDisplay, Mode=OneWay}"
                            CustomFields="{x:Bind ViewModel.EditingSecret.CustomFields, Mode=OneWay}"
                            Notes="{x:Bind ViewModel.EditingSecret.Notes, Mode=TwoWay}"
                            OpenCustomFieldUrlCommand="{x:Bind ViewModel.OpenCustomFieldUrlCommand}"
                            RemoveCustomFieldCommand="{x:Bind ViewModel.RemoveCustomFieldCommand}"
                            RemoveFileCommand="{x:Bind ViewModel.RemoveFileCommand}"
                            UpdatedAtText="{x:Bind ViewModel.EditingSecret.UpdatedAtDisplay, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="1"
                    Padding="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Left pane toggle (leftmost, Ctrl+B)  -->
                    <ToggleButton
                        x:Name="PaneToggleButton"
                        Click="PaneToggleButton_Click"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.ToggleLeftPane}">
                        <FontIcon x:Name="PaneToggleGlyph" FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE740;" />
                    </ToggleButton>

                    <!--  Divider (separates pane toggle from action buttons)  -->
                    <Border
                        Width="1"
                        Margin="4,0"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Draft compare/discard button (shown only for saved items with a draft)  -->
                    <Button
                        Click="CompareDraft_Click"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        ToolTipService.ToolTip="{loc:Msg Key=Secrets.Dialog.ReviewDraft}"
                        Visibility="{x:Bind ViewModel.EditingSecretHasDraft, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE70F;" />
                    </Button>

                    <Button
                        AutomationProperties.Name="{loc:Msg Key=Common.Save}"
                        Command="{x:Bind ViewModel.SaveSecretCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.Save}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74E;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{loc:Msg Key=Common.Delete}"
                        Command="{x:Bind ViewModel.DeleteSecretCommand}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.Delete}"
                        Visibility="{x:Bind ViewModel.EditingSecret.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74D;" />
                    </Button>
                    <!--  Divider (separates jump button)  -->
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.EditingSecret.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                    <!--  Jump to Time Machine (shown only for saved items): same icon as the Time Machine menu item  -->
                    <Button
                        Click="JumpToTimeMachine_Click"
                        IsEnabled="{x:Bind ViewModel.CanJumpToTimeMachine, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=Secrets.GoToTimeMachineTooltip}"
                        Visibility="{x:Bind ViewModel.EditingSecret.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE81C;" />
                    </Button>

                    <!--  Generation timestamps (next to the Time Machine button, saved items only)  -->
                    <StackPanel
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.EditingSecret.IsNew, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <!--  1 generation ago  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="3"
                            Visibility="{x:Bind ViewModel.EditingSecret.HasGen1Date, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid
                                Width="16"
                                Height="12"
                                VerticalAlignment="Center">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvIconSizeSmall}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE777;" />
                                <Border
                                    Height="9"
                                    MinWidth="9"
                                    Padding="1,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvCaptionFontSize}"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="1" />
                                </Border>
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvCaptionFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.EditingSecret.Gen1Date, Mode=OneWay}" />
                        </StackPanel>
                        <!--  2 generations ago  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="3"
                            Visibility="{x:Bind ViewModel.EditingSecret.HasGen2Date, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid
                                Width="16"
                                Height="12"
                                VerticalAlignment="Center">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvIconSizeSmall}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE777;" />
                                <Border
                                    Height="9"
                                    MinWidth="9"
                                    Padding="1,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource NvCaptionFontSize}"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="2" />
                                </Border>
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvCaptionFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.EditingSecret.Gen2Date, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
