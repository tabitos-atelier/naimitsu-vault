<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NaimitsuVault.Pages.TimeMachinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnDef" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPane" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Row="0"
                Margin="8,8,8,4"
                IsEnabled="{x:Bind ViewModel.HasAnySecrets, Mode=OneWay}"
                PlaceholderText="{loc:Msg Key=TimeMachine.SearchPlaceholder}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                x:Name="CategoryFilter"
                Grid.Row="1"
                Margin="8,4,8,0"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Name"
                IsEnabled="{x:Bind ViewModel.HasAnySecrets, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilterComboItems, Mode=OneWay}"
                SelectionChanged="CategoryFilter_SelectionChanged" />

            <StackPanel
                Grid.Row="2"
                Margin="8"
                Orientation="Horizontal"
                Spacing="8">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        Padding="6,4"
                        Foreground="#FFD700"
                        IsChecked="{x:Bind ViewModel.FilterFavoritesOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasFilteredFavorites, Mode=OneWay}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE735;" />
                    </ToggleButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FilteredFavoritesCount, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        Padding="6,4"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Click="DeletedFilter_Click"
                        IsChecked="{x:Bind ViewModel.FilterDeletedOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasFilteredDeleted, Mode=OneWay}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74D;" />
                    </ToggleButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FilteredDeletedCount, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="SecretListView"
                Grid.Row="3"
                ItemsSource="{x:Bind ViewModel.FilteredSecrets, Mode=OneWay}"
                KeyDown="SecretListView_KeyDown"
                SelectedItem="{x:Bind ViewModel.SelectedSecret, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="StarButton_Click">
                                <Grid>
                                    <FontIcon
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Foreground="#FFD700"
                                        Glyph="&#xE735;"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="{StaticResource NvIconSizeDefault}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE734;"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <!--  Favicon (protected-document icon when not yet fetched)  -->
                            <Grid
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="{StaticResource NvIconSizeSmall}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A6;" />
                                <Image Source="{Binding FaviconSource}" Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{Binding DisplayTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="3"
                                FontSize="{StaticResource NvIconSizeSmall}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;"
                                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" Padding="24,16,24,16">
            <Grid Visibility="{x:Bind ViewModel.SelectedSecret, Mode=OneWay, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <Image
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.2"
                    Source="ms-appx:///Assets/NaimitsuVault.png"
                    Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{loc:Msg Key=TimeMachine.SelectSecretPrompt}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid Visibility="{x:Bind ViewModel.SelectedSecret, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsDeleted, Mode=OneWay}"
                    Message="{x:Bind ViewModel.DeletedInfoMessage, Mode=OneWay}"
                    Severity="Warning" />

                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,4"
                    VerticalAlignment="Center"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvIconSizeDefault}"
                        Glyph="&#xE8EC;" />

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontSize="{StaticResource NvIconSizeDefault}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7C1;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvCaptionFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentHeader, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Grid
                            Width="24"
                            Height="16"
                            VerticalAlignment="Center">
                            <FontIcon
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Glyph="&#xE777;" />
                            <Border
                                Height="11"
                                MinWidth="11"
                                Padding="2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="3">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvCaptionFontSize}"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvCaptionFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Gen1Header, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Grid
                            Width="24"
                            Height="16"
                            VerticalAlignment="Center">
                            <FontIcon
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Glyph="&#xE777;" />
                            <Border
                                Height="11"
                                MinWidth="11"
                                Padding="2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="3">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvCaptionFontSize}"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvCaptionFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Gen2Header, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="RowsList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                    SelectionMode="None"
                    Tag="{x:Bind ViewModel}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0,4,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvCaptionFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding FieldLabel}" />

                                <!--  Current value, with the copy button overlaid at the text's right edge  -->
                                <Grid Grid.Column="1">
                                    <Grid Visibility="{Binding IsAttachmentRow, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,0,32,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CurrentDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding Tag.CopyValueCommand, ElementName=RowsList}"
                                            CommandParameter="{Binding CurrentCopyParam}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Visibility="{Binding HasCurrentValue, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                            <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE8C8;" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl
                                        ItemsSource="{Binding CurrentFiles}"
                                        Visibility="{Binding IsAttachmentRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Width="28"
                                                    Height="28"
                                                    ToolTipService.ToolTip="{Binding FileName}">
                                                    <Image
                                                        Source="{Binding ThumbnailBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                        Stretch="UniformToFill"
                                                        Visibility="{Binding ThumbnailBytes, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <FontIcon
                                                        FontSize="16"
                                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Glyph="{Binding FileTypeGlyph}"
                                                        Visibility="{Binding ThumbnailBytes, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                                                    <FontIcon
                                                        FontSize="16"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Glyph="&#xE7BA;"
                                                        Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!--  Gen1 value, with the copy button overlaid at the text's right edge  -->
                                <Grid Grid.Column="2">
                                    <Border
                                        Padding="4,2"
                                        Background="{Binding Gen1Differs, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                        CornerRadius="4">
                                        <Grid>
                                            <TextBlock
                                                Margin="0,0,28,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Gen1Display}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding IsAttachmentRow, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <ItemsControl
                                                ItemsSource="{Binding Gen1Files}"
                                                Visibility="{Binding IsAttachmentRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Width="28"
                                                            Height="28"
                                                            ToolTipService.ToolTip="{Binding FileName}">
                                                            <Image
                                                                Source="{Binding ThumbnailBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                                Stretch="UniformToFill"
                                                                Visibility="{Binding ThumbnailBytes, Converter={StaticResource NullToVisibilityConverter}}" />
                                                            <FontIcon
                                                                FontSize="16"
                                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Glyph="{Binding FileTypeGlyph}"
                                                                Visibility="{Binding ThumbnailBytes, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                                                            <FontIcon
                                                                FontSize="16"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                Glyph="&#xE7BA;"
                                                                Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding Tag.CopyValueCommand, ElementName=RowsList}"
                                        CommandParameter="{Binding Gen1CopyParam}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Visibility="{Binding Gen1CanCopy, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                        <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>

                                <!--  Gen2 value, with the copy button overlaid at the text's right edge  -->
                                <Grid Grid.Column="3">
                                    <Border
                                        Padding="4,2"
                                        Background="{Binding Gen2Differs, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                        CornerRadius="4">
                                        <Grid>
                                            <TextBlock
                                                Margin="0,0,28,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Gen2Display}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding IsAttachmentRow, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <ItemsControl
                                                ItemsSource="{Binding Gen2Files}"
                                                Visibility="{Binding IsAttachmentRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Width="28"
                                                            Height="28"
                                                            ToolTipService.ToolTip="{Binding FileName}">
                                                            <Image
                                                                Source="{Binding ThumbnailBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                                Stretch="UniformToFill"
                                                                Visibility="{Binding ThumbnailBytes, Converter={StaticResource NullToVisibilityConverter}}" />
                                                            <FontIcon
                                                                FontSize="16"
                                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Glyph="{Binding FileTypeGlyph}"
                                                                Visibility="{Binding ThumbnailBytes, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                                                            <FontIcon
                                                                FontSize="16"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                Glyph="&#xE7BA;"
                                                                Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding Tag.CopyValueCommand, ElementName=RowsList}"
                                        CommandParameter="{Binding Gen2CopyParam}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Visibility="{Binding Gen2CanCopy, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                                        <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">

                    <!--  Left pane open/close toggle (leftmost: Ctrl+B)  -->
                    <ToggleButton
                        x:Name="PaneToggleButton"
                        Click="PaneToggleButton_Click"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.ToggleLeftPane}">
                        <FontIcon x:Name="PaneToggleGlyph" FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE740;" />
                    </ToggleButton>

                    <!--  Divider (separates the pane toggle from the action buttons)  -->
                    <Border
                        Width="1"
                        Margin="4,0"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ToggleButton IsChecked="{x:Bind ViewModel.IsRevealed, Mode=TwoWay}" ToolTipService.ToolTip="{loc:Msg Key=Common.ToggleMask}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvIconSizeDefault}"
                            Glyph="&#xE7B3;" />
                    </ToggleButton>

                    <!--  Restore generation (most recent): UpdateRestore + badge "1"  -->
                    <Button
                        Command="{x:Bind ViewModel.RestoreGen1Command}"
                        IsEnabled="{x:Bind ViewModel.CanRestoreGen1, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=TimeMachine.UndoToGen1Tooltip}">
                        <Grid Width="24">
                            <FontIcon
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Glyph="&#xE777;" />
                            <Border
                                Height="14"
                                MinWidth="14"
                                Margin="0,5,0,0"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="7"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!--  Restore generation (one before): UpdateRestore + badge "2"  -->
                    <Button
                        Command="{x:Bind ViewModel.RestoreGen2Command}"
                        IsEnabled="{x:Bind ViewModel.CanRestoreGen2, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=TimeMachine.UndoToGen2Tooltip}">
                        <Grid Width="24">
                            <FontIcon
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Glyph="&#xE777;" />
                            <Border
                                Height="14"
                                MinWidth="14"
                                Margin="0,5,0,0"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="7"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                        </Grid>
                    </Button>

                    <!--  Divider (adds a bit of space before the delete-related buttons)  -->
                    <Border
                        Width="1"
                        Margin="8,0"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Undo delete (enabled only for soft-deleted secrets): Undo icon  -->
                    <Button
                        Command="{x:Bind ViewModel.UndeleteCommand}"
                        IsEnabled="{x:Bind ViewModel.IsDeleted, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.UndoDelete}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE7A7;" />
                    </Button>

                    <!--  Permanently delete (enabled only for soft-deleted secrets): EraseTool icon  -->
                    <Button
                        Command="{x:Bind ViewModel.PermanentDeleteCommand}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        IsEnabled="{x:Bind ViewModel.IsDeleted, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=Common.PurgePermanently}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvIconSizeDefault}"
                            Glyph="&#xE75C;" />
                    </Button>

                    <!--  Divider (separates the jump button)  -->
                    <Border
                        Width="1"
                        Margin="8,0"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Jump to Secrets (excludes deleted items): same icon as the Secrets menu item  -->
                    <Button
                        Click="JumpToSecretList_Click"
                        IsEnabled="{x:Bind ViewModel.CanJumpToSecretList, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=TimeMachine.GoToSecretsPageTooltip}">
                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xEA18;" />
                    </Button>
                </StackPanel>

                    <!--  Explains why the restore buttons (Gen1/Gen2) above are grayed out, instead of
                         blocking the jump into Time Machine itself while a draft is in progress  -->
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{loc:Msg Key=TimeMachine.DraftBlocksRestoreNotice}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsRestoreBlockedByDraft, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
