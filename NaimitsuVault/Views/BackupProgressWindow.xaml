<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="NaimitsuVault.Views.BackupProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Backmost brand watermark (decorative)  -->
        <Image
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="120"
            Height="120"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.1"
            Source="ms-appx:///Assets/NaimitsuVault.png" />

        <!--  Custom title bar (logo + static text; no standard control box)  -->
        <StackPanel
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Image
                Width="16"
                Height="16"
                Source="ms-appx:///Assets/NaimitsuVault.png" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource NvCaptionFontSize}"
                FontWeight="SemiBold"
                Text="Naimitsu Vault" />
        </StackPanel>

        <!--  Foreground layout (explicit reason message + ProgressRing)  -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                x:Name="MessageText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ProgressRing
                x:Name="BusyRing"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                IsActive="True" />
        </StackPanel>
    </Grid>
</winuiex:WindowEx>
