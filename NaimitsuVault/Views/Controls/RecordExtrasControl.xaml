<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NaimitsuVault.Views.Controls.RecordExtrasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NaimitsuVault.Views.Controls"
    xmlns:loc="using:NaimitsuVault.Localization">

    <StackPanel Spacing="8">

        <Border
            Height="1"
            Margin="0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  Custom fields  -->
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{loc:Msg Key=Common.CustomField}" />
            <ListView
                x:Name="CustomFieldList"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                ItemsSource="{x:Bind CustomFields, Mode=OneWay}"
                SelectionMode="None"
                Tag="{x:Bind ThisControl}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,4,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <!--  Grip handle  -->
                            <controls:GripHandle
                                Grid.Column="0"
                                FontSize="{StaticResource NvBodyFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE700;" />
                            <Grid
                                Grid.Column="1"
                                PointerEntered="LabelGrid_PointerEntered"
                                PointerExited="LabelGrid_PointerExited">
                                <Border
                                    Background="Transparent"
                                    CornerRadius="4"
                                    IsHitTestVisible="False" />
                                <TextBlock
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvBodyFontSize}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="1"
                                    Tapped="LabelDisplay_Tapped"
                                    Text="{Binding Label}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Label}" />
                                <TextBox
                                    MinHeight="0"
                                    Padding="4,8,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="{StaticResource NvBodyFontSize}"
                                    LostFocus="LabelEditor_LostFocus"
                                    Tag="Label"
                                    Text="{Binding Label, Mode=TwoWay}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBox
                                Grid.Column="2"
                                Padding="10,5,36,7"
                                GotFocus="CopyOverlayTextBox_GotFocus"
                                LostFocus="CopyOverlayTextBox_LostFocus"
                                PlaceholderText="{loc:Msg Key=Common.EnterText}"
                                Tag="Value"
                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding ShowAsTextPlain, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBox
                                Grid.Column="2"
                                Padding="10,5,36,7"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                GotFocus="CopyOverlayTextBox_GotFocus"
                                LostFocus="CopyOverlayTextBox_LostFocus"
                                PlaceholderText="{loc:Msg Key=Common.EnterWebsite}"
                                Tag="Value"
                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding ShowAsUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <PasswordBox
                                Grid.Column="2"
                                Padding="10,5,36,7"
                                DataContextChanged="CustomPasswordField_DataContextChanged"
                                PasswordChanged="CustomPasswordField_PasswordChanged"
                                PasswordRevealMode="{Binding IsRevealed, Converter={StaticResource BoolToPasswordRevealModeConverter}}"
                                PlaceholderText="{loc:Msg Key=Common.EnterPassword}"
                                Visibility="{Binding ShowAsPasswordBox, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <CalendarDatePicker
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                DataContextChanged="CustomDateField_DataContextChanged"
                                DateChanged="CustomDateField_DateChanged"
                                PlaceholderText="{loc:Msg Key=Common.SelectDate}"
                                Visibility="{Binding ShowAsDate, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!--  Copy button (overlaid inside the value box, right edge; hidden for date fields since CalendarDatePicker can't host it and there's no separate copy button for dates)  -->
                            <Button
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Margin="0,0,4,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding Tag.CopyCustomFieldCommand, ElementName=CustomFieldList}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasValue}"
                                Tag="CopyOverlay"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}"
                                Visibility="{Binding ShowAsDate, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE8C8;" />
                            </Button>
                            <!--  Reveal toggle (password fields only)  -->
                            <ToggleButton
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Center"
                                IsChecked="{Binding IsRevealed, Mode=TwoWay}"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.ToggleVisibility}"
                                Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE7B3;" />
                            </ToggleButton>
                            <!--  Enlarge-preview toggle (text fields only; reuses the same IsRevealed
                                 flag as the password reveal toggle above - the two are mutually
                                 exclusive per field via FieldType, so there's no conflict, and reusing
                                 it is what makes CustomFieldModel.PasswordToken light up for free.)  -->
                            <ToggleButton
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Center"
                                IsChecked="{Binding IsRevealed, Mode=TwoWay}"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.EnlargeDisplay}"
                                Visibility="{Binding ShowAsTextPlain, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon
                                    FontSize="{StaticResource NvIconSizeDefault}"
                                    Glyph="{Binding IsRevealed, Converter={StaticResource BoolToZoomGlyphConverter}}" />
                            </ToggleButton>
                            <!--  Date fields have no copy button (CalendarDatePicker can't host the overlay, and copying a date is rarely needed)  -->
                            <!--  Open URL (website fields only, same column as reveal toggle)  -->
                            <Button
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Command="{Binding Tag.OpenCustomFieldUrlCommand, ElementName=CustomFieldList}"
                                CommandParameter="{Binding}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IsEnabled="{Binding HasValue}"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.OpenInBrowser}"
                                Visibility="{Binding IsUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE774;" />
                            </Button>
                            <Button
                                Grid.Column="4"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Command="{Binding Tag.RemoveCustomFieldCommand, ElementName=CustomFieldList}"
                                CommandParameter="{Binding}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.DeleteField}">
                                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74D;" />
                            </Button>
                            <!--  Large password preview (password fields only, shown when reveal toggle is ON)  -->
                            <controls:PasswordLargePreviewControl
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                IsVisible="{Binding IsRevealed, Mode=OneWay}"
                                PasswordToken="{Binding PasswordToken, Mode=OneWay}"
                                Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!--  Large text preview (text fields only, shown when the enlarge toggle is ON;
                                 also groups an all-digit value into 4-char chunks, same as UserId's)  -->
                            <controls:UserIdLargePreviewControl
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                IsVisible="{Binding IsRevealed, Mode=OneWay}"
                                UserIdToken="{Binding PasswordToken, Mode=OneWay}"
                                Visibility="{Binding ShowAsTextPlain, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind AddCustomFieldCommand}"
                    CommandParameter="Text"
                    ToolTipService.ToolTip="{loc:Msg Key=Common.AddTextField}">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8D2;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind AddCustomFieldCommand}"
                    CommandParameter="Password"
                    ToolTipService.ToolTip="{loc:Msg Key=Common.AddPasswordField}">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE72E;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind AddCustomFieldCommand}"
                    CommandParameter="Url"
                    ToolTipService.ToolTip="{loc:Msg Key=Common.AddWebsiteField}">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE774;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind AddCustomFieldCommand}"
                    CommandParameter="Date"
                    ToolTipService.ToolTip="{loc:Msg Key=Common.AddDateField}">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE787;" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border
            Height="1"
            Margin="0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{loc:Msg Key=Common.Notes}" />
            <TextBox
                x:Name="NotesTextBox"
                Height="80"
                AcceptsReturn="True"
                PlaceholderText="{loc:Msg Key=Common.FreeInput}"
                Text="{x:Bind Notes, Mode=TwoWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Attached files (placed after Notes since it isn't always present, unlike the near-universal Notes field)  -->
        <StackPanel x:Name="AttachedFilesSection" Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{loc:Msg Key=Common.AttachedFiles}" />
            <!--  Drop-zone hint (hidden once at least one file is attached, to save vertical space)  -->
            <TextBlock
                FontSize="{StaticResource NvCaptionFontSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Msg Key=Common.DropZonePrompt}"
                Visibility="{x:Bind AttachedFiles.Count, Mode=OneWay, Converter={StaticResource ZeroCountToVisibilityConverter}}" />
            <TextBlock
                FontSize="{StaticResource NvCaptionFontSize}"
                Opacity="0.6"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="JPG, PNG, PDF, PEM, JSON, XML, LIC, etc."
                Visibility="{x:Bind AttachedFiles.Count, Mode=OneWay, Converter={StaticResource ZeroCountToVisibilityConverter}}" />
            <GridView
                MaxHeight="{x:Bind FilesMaxHeight, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="AttachedFile_ItemClick"
                ItemsSource="{x:Bind AttachedFiles, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="80"
                            Height="80"
                            ToolTipService.ToolTip="{Binding FileName}">
                            <Image
                                Source="{Binding ThumbnailData, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                Stretch="UniformToFill"
                                Visibility="{Binding ThumbnailData, Converter={StaticResource NullToVisibilityConverter}}" />
                            <FontIcon
                                FontSize="{StaticResource NvIconSizeXLarge}"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="{Binding FileTypeGlyph}"
                                Visibility="{Binding ThumbnailData, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                            <FontIcon
                                FontSize="{StaticResource NvIconSizeXLarge}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE7BA;"
                                ToolTipService.ToolTip="{loc:Msg Key=Common.AttachedFileQuarantined}"
                                Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button
                                Width="22"
                                Height="22"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Click="RemoveAttachedFile_Click"
                                Tag="{Binding}">
                                <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE894;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>

        <Border
            Height="1"
            Margin="0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvBodyFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE710;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind CreatedAtText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvBodyFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE7C1;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind UpdatedAtText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
