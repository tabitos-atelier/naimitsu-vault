<UserControl
    x:Class="NaimitsuVault.Views.Controls.VaultSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization"
    IsEnabled="{x:Bind BothIdle(VaultOpsVm.IsBusy, AppSettingsVm.IsBusy), Mode=OneWay}">

    <!--  See AppCommonSettingsControl.xaml for why these overrides exist (WinUI 3's default
         ToggleSwitch template bakes in 10px top+bottom margin beyond any external Margin/Spacing).  -->
    <UserControl.Resources>
        <x:Double x:Key="ToggleSwitchPreContentMargin">2</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
    </UserControl.Resources>

    <StackPanel Spacing="16">

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{loc:Msg Key=VaultSettings.SecurityGroup}" />
            <StackPanel Margin="28,0,0,0" Spacing="8">
                <ToggleSwitch
                    Header="{loc:Msg Key=VaultSettings.WindowsHelloUnlock}"
                    IsEnabled="{x:Bind AppSettingsVm.IsWindowsHelloSupported, Mode=OneWay}"
                    IsOn="{x:Bind AppSettingsVm.IsWindowsHelloEnabled, Mode=OneWay}"
                    OffContent="{loc:Msg Key=Common.Off}"
                    OnContent="{loc:Msg Key=Common.On}"
                    Toggled="WindowsHello_Toggled"
                    ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.BiometricEnrollment}" />

                <Expander
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8D7;" />
                            <TextBlock VerticalAlignment="Center" Text="{loc:Msg Key=VaultSettings.Dialog.ChangeMasterPassword}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind VaultOpsVm.HasPasswordError, Mode=OneWay}"
                            Message="{x:Bind VaultOpsVm.PasswordErrorMessage, Mode=OneWay}"
                            Severity="Error" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <PasswordBox
                                x:Name="OldPasswordBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                KeyDown="MasterPasswordBox_KeyDown"
                                PasswordChanged="OldPassword_Changed"
                                PlaceholderText="{loc:Msg Key=VaultSettings.CurrentMasterPassword}" />
                            <PasswordBox
                                x:Name="NewPasswordBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                KeyDown="MasterPasswordBox_KeyDown"
                                PasswordChanged="NewPassword_Changed"
                                PlaceholderText="{loc:Msg Key=VaultSettings.NewMasterPassword}" />
                            <PasswordBox
                                x:Name="ConfirmPasswordBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                KeyDown="MasterPasswordBox_KeyDown"
                                PasswordChanged="ConfirmPassword_Changed"
                                PlaceholderText="{loc:Msg Key=VaultSettings.ConfirmMasterPassword}" />
                        </Grid>
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{x:Bind VaultOpsVm.ChangePasswordCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.Dialog.ChangeMasterPassword}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8D7;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{loc:Msg Key=VaultSettings.Dialog.ChangeMasterPassword}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind VaultOpsVm.ResetPasswordWithHelloCommand}"
                                IsEnabled="{x:Bind CanResetWithHello(AppSettingsVm.IsWindowsHelloEnabled, VaultOpsVm.CanResetPasswordWithHelloFields), Mode=OneWay}"
                                ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.Dialog.ForceResetViaHelloInstructions}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE928;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{loc:Msg Key=VaultSettings.Dialog.HelloForceReset}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False"
                    ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.Dialog.EmergencyAccessConcept}">
                    <Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeDefault}"
                                Glyph="&#xED14;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{loc:Msg Key=VaultSettings.Dialog.EmergencyAccessSetup}" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind VaultOpsVm.HasEmergencyAccessCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvIconSizeSmall}"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE8FB;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource NvCaptionFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{loc:Msg Key=VaultSettings.Dialog.EmergencyCodeStatusIssued}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox
                                x:Name="EacPinBox"
                                Width="140"
                                HorizontalAlignment="Left"
                                KeyDown="EacPinBox_KeyDown"
                                MaxLength="4"
                                PasswordChanged="EacPinBox_PasswordChanged"
                                PlaceholderText="{loc:Msg Key=VaultSettings.Dialog.FourDigitsPin}" />
                            <PasswordBox
                                x:Name="EacPinConfirmBox"
                                Width="140"
                                HorizontalAlignment="Left"
                                KeyDown="EacPinBox_KeyDown"
                                MaxLength="4"
                                PasswordChanged="EacPinConfirmBox_PasswordChanged"
                                PlaceholderText="{loc:Msg Key=VaultSettings.Dialog.ConfirmPin}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind VaultOpsVm.CreateEmergencyAccessCodeCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.Dialog.EncryptQrWithPin}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xED14;" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{loc:Msg Key=VaultSettings.Dialog.GenerateOrReissueCode}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind VaultOpsVm.RevokeEmergencyAccessCodeCommand}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsEnabled="{x:Bind VaultOpsVm.HasEmergencyAccessCode, Mode=OneWay}"
                                    ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.Dialog.RevokeEmergencyCode}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74D;" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{loc:Msg Key=Common.Delete}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind VaultOpsVm.HasEmergencyAccessCodeError, Mode=OneWay}"
                            Message="{x:Bind VaultOpsVm.EmergencyAccessCodeErrorMessage, Mode=OneWay}"
                            Severity="Error" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{loc:Msg Key=VaultSettings.DataMigrationGroup}" />
            <StackPanel Margin="28,0,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        MinWidth="100"
                        SelectedValue="{x:Bind VaultOpsVm.ExportFormat, Mode=TwoWay}"
                        SelectedValuePath="Content">
                        <ComboBoxItem Content="JSON" />
                        <ComboBoxItem Content="CSV" />
                    </ComboBox>
                    <Button
                        Command="{x:Bind VaultOpsVm.ExportSecretsCommand}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        IsEnabled="{x:Bind VaultOpsVm.HasSecrets, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.PlainTextExportAction}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE896;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{loc:Msg Key=Common.Export}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind VaultOpsVm.ImportSecretsCommand}" ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.PlainTextImportAction}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE898;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{loc:Msg Key=Common.Import}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ToggleSwitch
                    Header="{loc:Msg Key=VaultSettings.IncludeTotpInExport}"
                    IsEnabled="{x:Bind VaultOpsVm.CanIncludeTotpInExport, Mode=OneWay}"
                    IsOn="{x:Bind VaultOpsVm.ExportIncludeTotp, Mode=TwoWay}"
                    OffContent="{loc:Msg Key=Common.Off}"
                    OnContent="{loc:Msg Key=Common.On}"
                    ToolTipService.ToolTip="{loc:Msg Key=VaultSettings.ExportTotpRiskWarning}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
