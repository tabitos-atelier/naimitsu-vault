                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 6" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleFavoriteFilter}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 7" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleDraftFilter}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 8" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleExpirationFilter}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 5" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleFavoriteItem}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + N" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
