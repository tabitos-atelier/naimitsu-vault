                    TextWrapping="Wrap" />
            </Grid>

            <!--  Edit screen footer toolbar, left to right: pane toggle -> draft review -> save -> delete -> jump to Time Machine  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
