            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 9" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleDeletedFilter}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 5" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleFavoriteItem}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Comparison-screen header toolbar, left to right: pane toggle -> restore Gen1 -> restore Gen2 -> undo delete -> purge -> jump to Secrets  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + B" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.ToggleLeftPane}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 1" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=TimeMachine.UndoToGen1Tooltip}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
