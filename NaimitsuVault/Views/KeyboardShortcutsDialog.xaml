                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + J" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Shell.Navi.TimeMachine}"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>

        <Rectangle
            Grid.Row="2"
            Grid.Column="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ===== Column 2: Time Machine =====  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="2"
            Margin="16,0,16,0"
            Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="{loc:Msg Key=Shell.Navi.TimeMachine}" />

            <!--  Left pane, top to bottom: filter row (Favorites/Deleted) -> list (per-item favorite star)  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 6" />
                </Border>
                <TextBlock
