                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.UndoDelete}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Del" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Text="{loc:Msg Key=Common.PurgePermanently}"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="88"
                    Padding="5,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + J" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvCaptionFontSize}"
