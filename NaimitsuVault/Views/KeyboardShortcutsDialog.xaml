<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NaimitsuVault.Views.KeyboardShortcutsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">860</x:Double>
        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{StaticResource NvCaptionFontSize}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid Padding="0,8,0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ===== Common actions (2-column layout, unchanged) =====  -->
        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="5"
            Margin="0,0,0,4"
            Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="{loc:Msg Key=Common.CommonOperations}" />
            <Grid ColumnSpacing="24" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        MinWidth="88"
                        Padding="5,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + L" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Text="{loc:Msg Key=Shell.LockNow}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        MinWidth="88"
                        Padding="5,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + K" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Text="{loc:Msg Key=Common.KeyboardShortcuts}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        MinWidth="88"
                        Padding="5,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + F" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Text="{loc:Msg Key=Common.FocusSearchBar}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        MinWidth="88"
                        Padding="5,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + H" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Text="{loc:Msg Key=Common.ToggleVisibility}"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </StackPanel>

        <Rectangle
            Grid.Row="1"
            Grid.ColumnSpan="5"
            Height="1"
            Margin="0,8,0,12"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ===== Column 1: Secrets =====  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,16,0"
            Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="{loc:Msg Key=Shell.Navi.Secrets}" />

            <!--  Left pane, top to bottom: filter row (Favorites/Draft/Expiration) -> list (per-item favorite star) -> Add button  -->
