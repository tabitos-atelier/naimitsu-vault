                        Padding="5,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock Style="{StaticResource KeyLabel}" Text="Ctrl + 3" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource NvCaptionFontSize}"
                        Text="{loc:Msg Key=Common.AddLink}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <Rectangle
            Grid.Row="3"
            Grid.ColumnSpan="5"
            Height="1"
            Margin="0,16,0,0"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Button
            Grid.Row="4"
            Grid.ColumnSpan="5"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Click="Close_Click"
            Content="{loc:Msg Key=Common.Close}"
            Style="{StaticResource AccentButtonStyle}" />

    </Grid>
</ContentDialog>
