        <Rectangle
            Grid.Row="2"
            Grid.Column="3"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ===== Column 3: Gallery + Viewer =====  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="4"
            Margin="16,0,0,0"
            Spacing="20">

            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{loc:Msg Key=Shell.Navi.Gallery}" />

                <!--  Top to bottom: pane toggle -> filter row (expiration) -> grid -> bottom toolbar (export/delete)  -->
