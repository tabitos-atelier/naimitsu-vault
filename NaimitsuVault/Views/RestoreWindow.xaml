<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="NaimitsuVault.Views.RestoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization"
    xmlns:winuiex="using:WinUIEx"
    Title="{loc:Msg Key=Restore.MainPage}">

    <Grid
        AllowDrop="True"
        Background="Transparent"
        DragOver="NkdbDropZone_DragOver"
        Drop="NkdbDropZone_Drop"
        RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel
            Grid.Row="0"
            Margin="28,20,28,14">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvIconSizeLarge}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE90F;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource NvTitleFontSize}"
                    FontWeight="SemiBold"
                    Text="{loc:Msg Key=Restore.MainPage}" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontSize="{StaticResource NvCaptionFontSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Msg Key=Restore.Description}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Backup file selection area  -->
        <Grid
            Grid.Row="1"
            Margin="28,0,28,12"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">

            <Border
                x:Name="NkdbDropZone"
                Grid.Column="0"
                Height="48"
                Padding="12,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid>
                    <StackPanel
                        x:Name="NkdbPlaceholderPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="{StaticResource NvIconSizeLarge}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xF540;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvCaptionFontSize}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{loc:Msg Key=Common.DropZone}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="NkdbAcceptedPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="{StaticResource NvIconSizeLarge}"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            x:Name="NkdbAcceptedNameText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NvCaptionFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            MaxWidth="350"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button
                x:Name="NkdbBrowseButton"
                Grid.Column="1"
                Width="48"
                Height="48"
                Click="NkdbBrowseButton_Click"
                Style="{StaticResource DefaultButtonStyle}"
                ToolTipService.ToolTip="{loc:Msg Key=Restore.SelectBackupFile}">
                <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xED25;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            Margin="28,8,28,0"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="False" />

        <StackPanel
            Grid.Row="3"
            Margin="28,12,28,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
            <Button
                x:Name="RestoreButton"
                IsEnabled="False"
                Click="RestoreButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="{StaticResource NvIconSizeSmall}" Glyph="&#xE777;" />
                    <TextBlock Text="{loc:Msg Key=Restore.ExecuteButton}" />
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</winuiex:WindowEx>
