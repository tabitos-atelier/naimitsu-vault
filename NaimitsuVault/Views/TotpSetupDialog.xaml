<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NaimitsuVault.Views.TotpSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NaimitsuVault.Localization">

    <!--  Custom footer instead of PrimaryButtonText/CloseButtonText: WinUI3's standard ContentDialog
         buttons are plain text with no icon slot, and this dialog needs Discard/Save with icons.
         Labeled "Save" rather than "Close" because confirming here force-saves immediately to the DB
         (GuardedSaveAsync in SecretsPage.xaml.cs) rather than staging a draft, unlike every other
         field on this page - 2FA is important enough to skip the draft step entirely.  -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            MaxHeight="560"
            VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,4,0,0" Spacing="12">

            <!--  Pre-verification: capture/manual entry. Collapsed once a valid secret is confirmed (StartTotpPreview).  -->
            <StackPanel x:Name="SetupPanel" Spacing="12">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{loc:Msg Key=Totp.ReadQrOption}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{loc:Msg Key=Totp.CaptureGuideText}" />

                <Button
                    x:Name="CaptureButton"
                    HorizontalAlignment="Left"
                    Click="CaptureButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="{StaticResource NvIconSizeLarge}" Glyph="&#xE722;" />
                        <TextBlock Text="{loc:Msg Key=Totp.ScreenCapture}" />
                    </StackPanel>
                </Button>

                <!--  Capture/recognition failures only. The success case is now shown by the phase
                     switch itself (SetupPanel collapses, the live code appears), so it needs no separate message.  -->
                <InfoBar
                    x:Name="QrInfoBar"
                    IsClosable="False"
                    IsOpen="False" />

                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{loc:Msg Key=Totp.DirectInputOption}" />

                <PasswordBox
                    x:Name="SecretTextBox"
                    AutomationProperties.Name="{loc:Msg Key=Totp.ExampleSecret}"
                    Header="{loc:Msg Key=Totp.SecretKeyBase32}"
                    PasswordChanged="SecretTextBox_PasswordChanged"
                    PasswordRevealMode="Hidden"
                    PlaceholderText="{loc:Msg Key=Totp.ExampleSecret}" />

                <TextBlock
                    x:Name="ValidationText"
                    FontSize="{StaticResource NvCaptionFontSize}"
                    Foreground="Red"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Authentication code preview (shown once the secret is confirmed)  -->
            <Border
                x:Name="TotpPreviewBorder"
                Margin="0,4,0,0"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <!--  Normal-color code  -->
                            <TextBlock
                                x:Name="TotpCodeNormal"
                                CharacterSpacing="150"
                                FontFamily="Consolas"
                                FontSize="{StaticResource NvTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <!--  Caution-color code (5 seconds or less remaining)  -->
                            <TextBlock
                                x:Name="TotpCodeExpiring"
                                CharacterSpacing="150"
                                FontFamily="Consolas"
                                FontSize="{StaticResource NvTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="TotpSecondsText"
                                VerticalAlignment="Bottom"
                                FontSize="{StaticResource NvCaptionFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="{loc:Msg Key=Common.CopyToClipboard}"
                            Click="CopyTotpCode_Click"
                            ToolTipService.ToolTip="{loc:Msg Key=Common.CopyToClipboard}">
                            <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>
                    <ProgressBar
                        x:Name="TotpProgressBar"
                        Maximum="30"
                        Minimum="0" />
                    <TextBlock
                        x:Name="TotpAdjacentText"
                        FontFamily="Consolas"
                        FontSize="{StaticResource NvBodyFontSize}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!--  Standalone, matching how captions are styled elsewhere in this dialog. Visibility
                 tracks TotpPreviewBorder (post-verification only) rather than the Secrets page's
                 tooltip-based treatment, since this dialog wants it visible without a hover.  -->
            <TextBlock
                x:Name="TotpTimeSyncText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{loc:Msg Key=Totp.TimeSyncNotice}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  Post-verification: backup code attachment. Hidden until a valid secret is confirmed (StartTotpPreview).  -->
            <StackPanel x:Name="BackupCodePanel" Spacing="12" Visibility="Collapsed">
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{loc:Msg Key=Totp.BackupCodeOptional}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="DropZone"
                        Grid.Column="0"
                        MinHeight="80"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1.5"
                        CornerRadius="4"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop">
                        <StackPanel
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource NvIconSizeLarge}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE898;" />
                            <TextBlock
                                x:Name="DropHintText"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource NvCaptionFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{loc:Msg Key=Totp.DropBackupCodeInstructions}" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="ThumbnailBorder"
                        Grid.Column="1"
                        Width="80"
                        Height="80"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <Image
                            x:Name="ThumbnailImage"
                            Margin="4"
                            Stretch="Uniform" />
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="DiscardButton"
                Click="DiscardButton_Click"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74D;" />
                    <TextBlock Text="{loc:Msg Key=Totp.DiscardButton}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="SaveSetupButton"
                Click="SaveSetupButton_Click"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{StaticResource NvIconSizeDefault}" Glyph="&#xE74E;" />
                    <TextBlock Text="{loc:Msg Key=Common.Save}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

</ContentDialog>
