<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off">
  <!-- NLog's own diagnostics are off: the internal log is unrotated and records full file paths and stack traces
       (e.g. when the log file itself cannot be written), which must not end up in a file users may send in.
       To debug this configuration locally, temporarily set internalLogLevel="Warn" and add
       internalLogFile="${basedir}/logs/internal-nlog.txt". -->
  <!-- Async targets to avoid blocking the UI thread -->
  <targets async="true">
    <!-- File output relative to the executable; silently skipped on read-only media.
         The layout deliberately renders only the exception type (never ${exception:format=tostring}): application
         code never passes exception objects, but framework loggers (Warn and above) can, and a full ToString()
         would put stack traces, file paths (including the OS user name) and exception messages into the log.
         Size is bounded: rolls daily and also above 10 MB, keeping 10 archives. -->
    <target name="logFile"
            xsi:type="File"
            encoding="utf-8"
            writeBom="true"
            lineEnding="CRLF"
            layout="${longdate} [${level:uppercase=true:padding=-5}] [${threadid:padding=3}] ${logger:shortName=true} - ${message}${onexception:inner= [${exception:format=type}]}"
            fileName="${basedir}/logs/${processname}.log"
            archiveFileName="${basedir}/logs/archive/${processname}_{###}.log"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveNumbering="Sequence"
            maxArchiveFiles="10" />
  </targets>
  <rules>
    <!-- Rules are evaluated top to bottom; a matching rule with final="true" and no writeTo discards the event.
         EF Core's command logger emits every executed SQL statement (table and column names) at Info, and its
         Warn/Error text can embed the statement too, so EF Core output is discarded at every level. -->
    <logger name="Microsoft.EntityFrameworkCore.*" final="true" />
    <!-- Other framework loggers: keep Warn and above only -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <!-- Application loggers (ILogger&lt;T&gt; categories are the fully qualified type name, NaimitsuVault.*) -->
    <logger name="*" minlevel="Info" writeTo="logFile" />
  </rules>
</nlog>